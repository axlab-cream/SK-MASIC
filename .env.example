# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_COPY=gpt-5.1
OPENAI_MODEL_LAYOUT=gpt-5.1-mini
OPENAI_MODEL_IMAGE=gpt-image-1

# 크롤러
SKMAGIC_BASE=https://www.skmagic.com
SKMAGIC_CDN=https://static.skmagic.com
CRAWL_CONCURRENCY=3
CRAWL_DELAY_MS=800

# 렌더
RENDER_SCALE=1
RENDER_TIMEOUT_MS=15000
PNG_MAX_KB=500

# 카탈로그 신선도 (일). 초과 시 배너 생성 차단
CATALOG_MAX_AGE_DAYS=7
PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
