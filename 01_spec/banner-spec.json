  "safeZone": {
    "formula": "m = round(min(W,H) * 0.06); bottom = m + noticeH + 8",
    "exception": "notice 만 세이프존 밖 허용"
  },
  "font": {
    "readableMin": "max(18, round(min(W,H) * 0.03))",
    "auxMin": "max(14, round(min(W,H) * 0.014))",
    "auxScope": [
      "notice",
      "단위 접미사(원)",
      "취소선 기준가"
    ],
    "reason": "카톡은 이미지를 압축·축소해 보여주므로 이 값 아래면 실기기에서 판독 불가"
  },
  "qa": {
    "iouTextProduct": 0.02,
    "iouTextText": 0,
    "contrast": 4.5,
    "contrastLarge": 3.0,
    "largePx": 24,
    "pngMaxKB": 500,
    "exclusionPadRatio": 0.02,
    "collisionIouTrigger": 0.05,
    "maxCollisionPasses": 5
  },
  "retry": {
    "copy": 2,
    "compose": 5,
    "then": "규격 격상 → 그래도 실패면 목록에서 제외",
    "minCandidates": 3
  },
  "naming": {
    "single": "SGL-{model}-{sizeId}-{styleId}.png",
    "composite": "CMP-{n}P-{sizeId}-{styleId}.png",
    "dir": "04_output/{single|composite}/{yyyymmdd}/"
  }
}